kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
networking:
  apiServerAddress: "172.17.0.1"
  apiServerPort: 5443
  podSubnet: "10.246.0.0/16"
  serviceSubnet: "10.98.0.0/16"
featureGates:
  StructuredAuthenticationConfiguration: true
kubeadmConfigPatches:
  - |
    kind: ClusterConfiguration
    apiServer:
      extraArgs:
        authentication-config: /etc/kubernetes/pki/authn/config.yaml
      extraVolumes:
        - name: authn
          hostPath: /etc/kubernetes/pki/authn
          mountPath: /etc/kubernetes/pki/authn
          readOnly: true
          pathType: DirectoryOrCreate
nodes:
  - role: control-plane
    extraMounts:
      - hostPath: TARGET_AUTHN_HOSTPATH_PLACEHOLDER
        containerPath: /etc/kubernetes/pki/authn
        readOnly: true
